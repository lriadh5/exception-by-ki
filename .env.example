# Copy this file to .env.local for development, or set these in your
# hosting provider's environment variable settings for production.

# ---- Required in production builds ----
# Public site origin, no trailing slash. Used for canonical URLs, the
# sitemap, robots.txt, and Open Graph metadata. `npm run build` fails
# without this set when NODE_ENV=production. Optional in development
# (defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=https://www.exceptionbyki.com

# ---- Shopify connection (optional) ----
# Leave both unset to run the app in preview mode: sample catalog data,
# checkout disabled, a preview banner shown site-wide. Set both to switch
# to the real Shopify Storefront API and enable checkout. See README.md
# "Connecting Shopify" for how to obtain these from the Shopify admin.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Storefront API version. Defaults to 2024-10 if unset.
SHOPIFY_API_VERSION=2024-10
